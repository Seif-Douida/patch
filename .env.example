# Copy to .env (gitignored) for local development. Values here are dummies.

# Local SQL Server container (compose.yaml) and integration tests.
PP_TEST_SA_PASSWORD=change-me-Local-1

# Pipeline settings (src/patchpulse/config.py). Locally they point at the container.
PP_DB_HOST=localhost
PP_DB_PORT=1433
PP_DB_NAME=patchpulse
PP_DB_USER=sa
PP_DB_PASSWORD=change-me-Local-1
PP_DB_TRUST_CERT=true
PP_WRITER_PASSWORD=change-me-Writer-1
PP_AUTHOR_HASH_SALT=change-me-salt
PP_BACKFILL_BUDGET_MINUTES=5
